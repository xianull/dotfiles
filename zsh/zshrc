# conda（替换了 `conda init` 生成的块；别再跑 `conda init zsh`，它会再加回来）
# `conda shell.zsh hook` 的输出就是 conda.sh，直接 source，省一次 python（~280ms）。
# 新 shell 里激活 base 也不走 `conda activate`（又一次 python，~270ms），
# 直接设它会 export 的那几个变量。`conda activate / deactivate` 照常用。
# ponytail: base 激活是照 conda 25.5 的输出手写的；base 以后加了
# etc/conda/activate.d 脚本，或升级后行为不对，就把 if 块换成 `conda activate base`
if [[ -f "$HOME/.miniconda/etc/profile.d/conda.sh" ]]; then
  . "$HOME/.miniconda/etc/profile.d/conda.sh"
  if [[ ${CONDA_SHLVL:-0} == 0 ]]; then
    path=("$HOME/.miniconda/bin" $path)
    unset _CE_M _CE_CONDA
    export CONDA_PREFIX="$HOME/.miniconda" CONDA_SHLVL=1 CONDA_DEFAULT_ENV=base CONDA_PROMPT_MODIFIER='(base) '
  fi
fi

