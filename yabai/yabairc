#!/usr/bin/env sh

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# external_bar: all:<top>:<bottom> —— 主屏+笔记本有栏；Sidecar 会空 40px
yabai -m config external_bar               all:40:0       \
                mouse_follows_focus        off            \
                focus_follows_mouse        off            \
                window_zoom_persist        off            \
                window_placement           second_child   \
                window_shadow              float          \
                window_opacity             off             \
                window_opacity_duration    0.2            \
                active_window_opacity      1.0            \
                normal_window_opacity      0.9            \
                window_animation_duration  0.15           \
                window_animation_easing    ease_out_quint \
                insert_feedback_color      0xff9dd274     \
                split_ratio                0.50           \
                auto_balance               off            \
                mouse_modifier             fn             \
                mouse_action1              move           \
                mouse_action2              resize         \
                mouse_drop_action          swap           \
                                                          \
                top_padding                12              \
                bottom_padding             12              \
                left_padding               14             \
                right_padding              14             \
                window_gap                 10

yabai -m config layout bsp

# ---------------------------------------------------------------------------
# manage=off: float apps that are AX-noisy or break tiling.
# Match REAL process names (yabai uses the app name from AX / NSRunningApplication).
# Chinese + English aliases both listed where macOS may report either.
# ---------------------------------------------------------------------------

# System / OS utilities
yabai -m rule --add app="^(System Settings|系统设置|System Preferences|系统偏好设置)$" manage=off
yabai -m rule --add app="^(Finder|访达)$" manage=off
yabai -m rule --add app="^(Activity Monitor|活动监视器|Calculator|计算器|Dictionary|词典|App Store|Software Update|Archive Utility|Photo Booth|System Information)$" manage=off
yabai -m rule --add app="^(Calendar|日历|Maps|地图|Photos|照片|Music|音乐|TV|Podcasts|播客|Reminders|提醒事项|Notes|备忘录|Stickies|便笺)$" manage=off

# Dialogs / sheets that should never tile
yabai -m rule --add label="Finder dialogs" app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref)" manage=off
yabai -m rule --add label="Safari prefs" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off
yabai -m rule --add label="About This Mac" app="^System Information$" title="About This Mac" manage=off
yabai -m rule --add label="Inkscape save" app="^Inkscape$" title="Select file to save to" manage=off

# IM / meeting / social — highest hang risk (bad Accessibility)
yabai -m rule --add app="^(微信|WeChat|QQ|飞书|Lark|Feishu|钉钉|DingTalk|Telegram|Discord|Slack)$" manage=off
yabai -m rule --add app="^(腾讯会议|TencentMeeting|Tencent Meeting|zoom\.us|Zoom|Microsoft Teams|Teams)$" manage=off

# Media / music
yabai -m rule --add app="^(Spotify|网易云音乐|NeteaseMusic|QQ音乐|IINA|VLC|QuickTime Player)$" manage=off

# Proxy / network / tray utilities
yabai -m rule --add app="^(Clash Verge|ClashX|Surge|Shadowrocket|Tailscale|LuLu|Little Snitch|WiFi Explorer)$" manage=off

# Password / launcher / floating tools
yabai -m rule --add app="^(Raycast|Alfred|1Password|1Password 7|1Password 8|Bob|CleanShot|CleanMyMac|Tencent Lemon|AppCleaner)$" manage=off

# Electron / AI / finance / misc that fight tiling or spam AX
yabai -m rule --add app="^(ChatGPT|Claude|Perplexity|同花顺|Steam|PlayCover|CrossOver|MATLAB|Android Studio|印象笔记|Evernote|Downie 4|MotionPro|discover|CC Switch|360安全云盘|Python|LibreOffice|Epson iProjection)$" manage=off

# Catch-all for leftover float titles (WeChat mini-programs etc.)
yabai -m rule --add app="^(朋友圈|小程序)$" manage=off

# ---------------------------------------------------------------------------
# Space assignments (still apply to floating apps — moves them to a space)
# ---------------------------------------------------------------------------

# Space 1
yabai -m rule --add app="^Google Chrome$" space=1

# Space 3
yabai -m rule --add app="^Cursor$" space=3
yabai -m rule --add app="^(Code|Visual Studio Code)$" space=3

# Space 4
yabai -m rule --add app="^(WPS|WPS Office)$" space=4

# WeChat scratchpad: home is space 6 when hidden; scratchpad-wechat.sh summons to current space.
yabai -m rule --add label="wechat-scratchpad" app="^(微信|WeChat)$" scratchpad=wechat space=6 grid=6:6:1:1:4:4

# Space 6 — social
yabai -m rule --add app="^QQ$" space=6
yabai -m rule --add app="^(飞书|Lark|Feishu)$" space=6

# Space 7 — media / proxy
yabai -m rule --add app="^Clash Verge$" space=7
yabai -m rule --add app="^Spotify$" space=7
yabai -m rule --add app="^(网易云音乐|NeteaseMusic)$" space=7
yabai -m rule --add app="^QQ音乐$" space=7

# NOTE: Ghostty macOS native tabs appear as separate windows to yabai (OS API limit).
# Do NOT auto-stack / force-relayout on window_created — it breaks Chinese IME.
# Prefer Ghostty splits (in-app) over tabs when tiling; see ghostty/config keybinds.
# https://ghostty.org/docs/help/macos-tiling-wms

# Re-evaluate rules against already-open windows (needs scripting addition for some ops)
yabai -m rule --apply 2>/dev/null || true

# SketchyBar stack index. Remove-then-add so yabairc is idempotent.
SB=/opt/homebrew/bin/sketchybar
for _lbl in sb_window_focus sb_window_destroy sb_window_min sb_window_unmin sb_space_changed sb_title_change; do
  yabai -m signal --remove "$_lbl" 2>/dev/null || true
done
yabai -m signal --add event=window_focused       label=sb_window_focus   action="$SB --trigger window_focus"
yabai -m signal --add event=window_destroyed     label=sb_window_destroy action="$SB --trigger window_focus"
yabai -m signal --add event=window_minimized     label=sb_window_min     action="$SB --trigger window_focus"
yabai -m signal --add event=window_deminimized   label=sb_window_unmin   action="$SB --trigger window_focus"
yabai -m signal --add event=space_changed        label=sb_space_changed  action="$SB --trigger window_focus"

echo "yabai configuration loaded.."
